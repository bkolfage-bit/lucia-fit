# Database credentials are supplied by the Kimi website runtime.
# Add these values to enable real Stripe Checkout payments.
STRIPE_SECRET_KEY=sk_live_or_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Admin dashboard (/admin). Required for the dashboard to work.
# Choose a strong private passcode; Lucia signs in with it.
ADMIN_PASSCODE=replace_me_with_a_strong_passcode

# Optional: separate secret used to sign the admin session cookie.
# Defaults to ADMIN_PASSCODE when unset. Set this if you ever want to
# invalidate all sessions without changing the passcode.
# ADMIN_SESSION_SECRET=
