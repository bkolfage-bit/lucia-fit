# Database credentials are supplied by the Kimi website runtime.
# Add these values to enable real Stripe Checkout payments.
STRIPE_SECRET_KEY=sk_live_or_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Add these values to enable Venmo through Braintree. Never expose the private key to the browser.
BRAINTREE_ENVIRONMENT=sandbox
BRAINTREE_MERCHANT_ID=replace_me
BRAINTREE_PUBLIC_KEY=replace_me
BRAINTREE_PRIVATE_KEY=replace_me
# Optional: use a specific merchant account or Venmo business profile.
BRAINTREE_MERCHANT_ACCOUNT_ID=
BRAINTREE_VENMO_PROFILE_ID=
